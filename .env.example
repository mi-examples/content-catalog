# Personal Access Token for the MI instance in pp-dev.config.ts.
# Generate one in MI: Admin > Utilities > API Tokens (or your instance's equivalent).
MI_ACCESS_TOKEN=

# Portal Page (app) ID that holds this app's Variables.
MI_APP_ID=

# Render the UI from src/api/fixtures instead of calling the MI instance.
# VITE_USE_FIXTURES=1
